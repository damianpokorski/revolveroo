{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "docs:openapi": "bun run scripts/generate-openapi.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test ./src --isolate",
    "test:coverage": "bun test ./src --coverage --isolate"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/static": "^1.4.10",
    "@revolver/env": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "dotenv": "catalog:",
    "elysia": "^1.4.28",
    "yaml": "^2.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@revolver/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.21.9",
    "typescript": "catalog:"
  }
}
