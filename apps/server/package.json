{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"test": "bun test ./src",
		"test:coverage": "bun test ./src --coverage"
	},
	"dependencies": {
		"@elysia/openapi": "^1.4.15",
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/static": "^1.4.10",
		"@revolver/db": "workspace:*",
		"@revolver/env": "workspace:*",
		"@sinclair/typebox": "^0.34.49",
		"dotenv": "catalog:",
		"elysia": "^1.4.28",
		"uuid": "^14.0.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@revolver/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/uuid": "^11.0.0",
		"tsdown": "^0.21.9",
		"typescript": "catalog:"
	}
}
