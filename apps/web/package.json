{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate:icons": "bun run scripts/generate-icon-data.ts",
    "fonts:setup": "bun run scripts/setup-nerd-font.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:visual": "playwright test visual",
    "test:e2e:visual:update": "playwright test visual --update-snapshots",
    "docs:screenshots": "playwright test --config=playwright.showcase.config.ts"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@sendspin/sendspin-js": "^6.1.0",
    "qrcode-svg": "^1.1.0",
    "server": "workspace:*",
    "svelte-dnd-action": "^0.9.70"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@revolver/config": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "emojibase-data": "^17.0.0",
    "fflate": "^0.8.3",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.4",
    "typescript": "catalog:",
    "vite": "^8.0.10",
    "wawoff2": "^2.0.1"
  }
}
