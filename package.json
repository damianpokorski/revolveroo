{
  "name": "revolver",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:server": "vp run --filter server dev",
    "dev:web": "vp run --filter web dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "test": "vp run -r test",
    "test:coverage": "vp run -r test:coverage",
    "test:e2e": "vp run --filter web test:e2e",
    "test:e2e:install": "vp run --filter web test:e2e:install",
    "test:e2e:visual": "vp run --filter web test:e2e:visual",
    "test:e2e:visual:update": "vp run --filter web test:e2e:visual:update",
    "check": "biome check --write .",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "scripts/biome-staged.sh",
    "hooks:setup": "vp config",
    "fonts:setup": "vp run --filter web fonts:setup",
    "check-versions": "scripts/check-tool-versions.sh",
    "release:dry": "semantic-release --dry-run --no-ci",
    "docker:stop": "(docker stop revolver  2&> /dev/null || echo 'No containers needing stopping') && (docker rm -f revolver 2&> /dev/null || echo 'No old containers to remove') ",
    "docker": "docker buildx build -t revolver . && bun run docker:stop && docker run -it --name revolver -p 80:80 -v revolver-data:/data revolver"
  },
  "dependencies": {
    "@revolver/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@revolver/config": "workspace:*",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@types/bun": "catalog:",
    "rolldown": "1.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "catalog:",
    "vite-plus": "0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "bun@1.3.14"
}
