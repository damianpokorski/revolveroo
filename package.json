{
	"name": "revolver",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/bun": "^1.3.4"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "vp run -r --parallel dev",
		"dev:server": "vp run --filter server dev",
		"dev:web": "vp run --filter web dev",
		"build": "vp run -r build",
		"check-types": "vp run -r check-types",
		"test": "vp run -r test",
		"test:coverage": "vp run -r test:coverage",
		"test:e2e": "vp run --filter web test:e2e",
		"test:e2e:install": "vp run --filter web test:e2e:install",
		"check": "biome check --write .",
		"lint": "vp lint",
		"format": "vp fmt",
		"staged": "vp staged",
		"hooks:setup": "vp config",
		"fonts:setup": "vp run --filter web fonts:setup",
		"db:push": "vp run --filter @revolver/db db:push",
		"db:studio": "vp run --filter @revolver/db db:studio",
		"db:generate": "vp run --filter @revolver/db db:generate",
		"db:migrate": "vp run --filter @revolver/db db:migrate",
		"db:local": "vp run --filter @revolver/db db:local",
		"migrate": "vp run --filter @revolver/migrate start",
		"dev:migrate": "bun run migrate",
		"docker:stop": "(docker stop revolver  2&> /dev/null || echo 'No containers needing stopping') && (docker rm -f revolver 2&> /dev/null || echo 'No old containers to remove') ",
		"docker": "docker buildx build -t revolver . && bun run docker:stop && docker run -it --name revolver -p 3000:3000 -v revolver-data:/data revolver"
	},
	"dependencies": {
		"@revolver/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@revolver/config": "workspace:*",
		"@types/bun": "catalog:",
		"rolldown": "1.1.0",
		"typescript": "catalog:",
		"vite-plus": "0.1.24"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
		"vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
	},
	"packageManager": "bun@1.3.14"
}
